#
# =============================================================================
# .env.production.example  —  template สำหรับ Production บน Plesk
#
# วิธีใช้:
#   1. Copy ไฟล์นี้ไปวางบน server (Plesk → File Manager) ที่ root ของแอป
#      แล้ว rename เป็น .env (ไม่มี .example)
#   2. ใส่ค่าจริงทุกบรรทัด (DB password, APP_KEY ฯลฯ)
#   3. ทำที่บรรทัดล่างสุด: php artisan key:generate (ถ้า Plesk ไม่มี CLI ให้
#      generate ใน local แล้ว copy ค่ามาใส่: php artisan key:generate --show)
# =============================================================================

APP_NAME="Households KORAT"
APP_ENV=production
APP_KEY=                                          # << ใส่ key ที่ generate ใหม่ (ขึ้นต้นด้วย base64:)
APP_DEBUG=false
APP_URL=https://households-koratnopoor.nrru.ac.th

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ----- Database (Plesk MySQL) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                                 # << ปกติ Plesk ใช้ localhost / 127.0.0.1
DB_PORT=3306
DB_DATABASE=                                      # << ชื่อ DB ที่สร้างใน Plesk
DB_USERNAME=                                      # << user ที่สร้างใน Plesk
DB_PASSWORD=                                      # << password DB

# ----- Sessions / Sanctum (สำคัญมาก!) -----
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=households-koratnopoor.nrru.ac.th
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true                        # https → ต้อง true

SANCTUM_STATEFUL_DOMAINS=households-koratnopoor.nrru.ac.th

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}"
